# 🔐 Environment variables
.env
.env.local
.env.*
!.env.example

# 🐍 Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.sqlite3

# 📦 Virtual environments
venv/
env/
ENV/

# 🧪 Testing / coverage
.coverage
htmlcov/
.pytest_cache/

# 🧾 Logs
*.log

# 📁 Data / outputs (SAFE version)
data/*.csv
data/*.json
analysis_*.txt

# ⚠️ BUT keep important config JSON (optional)
!package.json
!tsconfig.json

# 🧠 AI / ML artifacts (VERY IMPORTANT for your project)
*.pt
*.pth
*.onnx
*.pkl
*.h5

# The production predictor and its SHAP background must be deployed together.
# Keep other generated joblib files out of version control unless explicitly
# whitelisted here.
*.joblib
!agents/failure_prediction/model.joblib
!agents/failure_prediction/scaler.joblib
!agents/failure_prediction/shap_background.joblib

# 📦 Zipped files
*.zip

# 🖥️ OS files
.DS_Store
Thumbs.db

# 💻 IDE files
.vscode/
.idea/

# 🚀 Node (if frontend exists)
node_modules/
.next/
dist/
build/

# 🔥 Misc
*.bak
*.swp
